# OPTIONAL — only needed if you deploy the serverless proxy in
# netlify/functions/financial-tips.js so visitors can use the AI
# Financial Tips tab without their own Claude API key.
#
# The app does NOT need this by default: it asks the user for a key
# on the page and calls Anthropic straight from the browser.
#
# Copy this file's contents into your hosting platform's Environment
# Variables settings (Netlify: Site configuration > Environment variables).
# Do NOT commit a real key to git — this file is a template only.

ANTHROPIC_API_KEY=sk-ant-your-key-here
